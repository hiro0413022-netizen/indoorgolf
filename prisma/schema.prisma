generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Member {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  phone            String?
  passwordHash     String
  plan             MemberPlan    @default(REGULAR)
  status           MemberStatus  @default(ACTIVE)
  joinedAt         DateTime      @default(now())
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Stripe 定期課金（月会費）
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  subscriptionStatus     SubscriptionStatus @default(NONE)
  currentPeriodEnd       DateTime?          // 当月課金の有効期限

  trialId          String?       @unique // 体験から入会した場合の紐付け
  trial            Trial?        @relation(fields: [trialId], references: [id])

  reservations     Reservation[]
  payments         Payment[]
}

/// 体験申し込み（見込み客）— 入会ファネルの起点
model Trial {
  id            String       @id @default(cuid())
  name          String
  email         String
  phone         String
  preferredDate DateTime?    // 体験希望日時
  source        String?      // 流入経路（Web/SNS/紹介など）
  status        TrialStatus  @default(APPLIED)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  survey        TrialSurvey?
  member        Member?
}

enum TrialStatus {
  APPLIED    // 申し込み受付
  SCHEDULED  // 体験日確定
  COMPLETED  // 体験実施済み
  CONVERTED  // 入会済み
  CANCELLED  // キャンセル/見送り
}

/// 体験後アンケート — 体験(Trial)に1:1で紐付く
model TrialSurvey {
  id             String   @id @default(cuid())
  trialId        String   @unique
  satisfaction   Int      // 総合満足度 1〜5
  simulatorScore Int      // シミュレーター体験 1〜5
  staffScore     Int      // スタッフ対応 1〜5
  joinIntent     Int      // 入会意向 1〜5
  interestedPlan MemberPlan? // 関心のあるプラン
  comment        String?
  createdAt      DateTime @default(now())

  trial          Trial    @relation(fields: [trialId], references: [id])
}

enum MemberPlan {
  REGULAR    // 月16,500円 - 1日1回60分
  MASTER     // 月22,000円 - 制限なし・同伴月2回
  LESSON     // 月11,000円 - 週1レッスン
  CORPORATE  // 月33,000円 - 法人
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Bay {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  isActive     Boolean       @default(true)

  reservations Reservation[]
}

model Reservation {
  id          String            @id @default(cuid())
  memberId    String
  bayId       String
  startAt     DateTime
  endAt       DateTime
  status      ReservationStatus @default(CONFIRMED)
  guestCount  Int               @default(0)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  member      Member            @relation(fields: [memberId], references: [id])
  bay         Bay               @relation(fields: [bayId], references: [id])
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Payment {
  id                    String        @id @default(cuid())
  memberId              String
  amount                Int
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique // 定期課金（請求書）の冪等キー
  paidAt                DateTime?
  description           String?
  createdAt             DateTime      @default(now())

  member                Member        @relation(fields: [memberId], references: [id])
}

enum SubscriptionStatus {
  NONE       // 未契約
  ACTIVE     // 課金中
  PAST_DUE   // 支払い遅延
  CANCELED   // 解約済み
}

enum PaymentType {
  MONTHLY_FEE
  BAY_FEE
  GUEST_FEE
  LESSON_FEE
  EVENT_FEE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
